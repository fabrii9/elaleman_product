<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Foto del producto: clic para verla en grande (plantilla y variante) -->
    <record id="product_template_form_view_image_lightbox" model="ir.ui.view">
        <field name="name">product.template.form.image.lightbox</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="image_1920" position="attributes">
                <attribute name="widget">image_lightbox</attribute>
            </field>
        </field>
    </record>

    <record id="product_variant_easy_edit_view_image_lightbox" model="ir.ui.view">
        <field name="name">product.product.variant.easy.edit.image.lightbox</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <field name="image_1920" position="attributes">
                <attribute name="widget">image_lightbox</attribute>
            </field>
        </field>
    </record>
</odoo>
