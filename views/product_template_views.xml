<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario común (plantilla y variante): datos del repuesto debajo de Marcas -->
    <record id="product_template_form_view_repuesto" model="ir.ui.view">
        <field name="name">product.template.form.repuesto</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="custom_product_brand.view_product_template_form_inherit_brand"/>
        <field name="arch" type="xml">
            <field name="brand_ids" position="after">
                <field name="condition"/>
                <field name="transmission_ids" widget="many2many_tags"
                       options="{'no_create_edit': True}"/>
            </field>
        </field>
    </record>

    <!-- Formulario común: estado de compra y proveedores debajo de Política de facturación -->
    <record id="product_template_form_view_compra" model="ir.ui.view">
        <field name="name">product.template.form.repuesto.compra</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="invoice_policy" position="after">
                <field name="purchase_status" widget="radio" options="{'horizontal': true}"/>
                <!-- Mismos proveedores que la pestaña Compra (mismo campo, misma lista editable) -->
                <separator string="Proveedores" colspan="2" groups="purchase.group_purchase_user"/>
                <field name="seller_ids" colspan="2" nolabel="1"
                       groups="purchase.group_purchase_user"
                       context="{'default_product_tmpl_id': id, 'product_template_invisible_variant': True, 'list_view_ref': 'elaleman_product.product_supplierinfo_list_repuesto'}"
                       invisible="product_variant_count &gt; 1" readonly="product_variant_count &gt; 1"/>
                <field name="variant_seller_ids" colspan="2" nolabel="1"
                       groups="purchase.group_purchase_user"
                       context="{'model': 'product.template', 'active_id': id, 'list_view_ref': 'elaleman_product.product_supplierinfo_list_repuesto'}"
                       invisible="product_variant_count &lt;= 1" readonly="product_variant_count &lt;= 1"/>
            </field>
        </field>
    </record>

    <!-- Lista de proveedores de la ficha: la de Compra, con cantidad y moneda siempre visibles -->
    <record id="product_supplierinfo_list_repuesto" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.repuesto</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="purchase.product_supplierinfo_tree_view2"/>
        <field name="mode">primary</field>
        <field name="priority" eval="1000"/>
        <field name="arch" type="xml">
            <field name="min_qty" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="currency_id" position="attributes">
                <attribute name="groups"></attribute>
            </field>
        </field>
    </record>

    <record id="product_product_supplierinfo_list_repuesto" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.repuesto.product</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="elaleman_product.product_supplierinfo_list_repuesto"/>
        <field name="mode">primary</field>
        <field name="priority" eval="1000"/>
        <field name="arch" type="xml">
            <field name="product_id" position="attributes">
                <attribute name="domain">[('product_tmpl_id', '=', parent.product_tmpl_id)]</attribute>
            </field>
        </field>
    </record>

    <!-- Formulario de plantilla: la etiqueta de la referencia está fija en la vista -->
    <record id="product_template_only_form_view_sku" model="ir.ui.view">
        <field name="name">product.template.only.form.sku</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="string">SKU interno</attribute>
            </field>
            <field name="default_code" position="after">
                <field name="supplier_sku"/>
                <field name="legacy_code" readonly="1" invisible="not legacy_code"/>
            </field>
        </field>
    </record>

    <record id="product_template_tree_view_repuesto" model="ir.ui.view">
        <field name="name">product.template.list.repuesto</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="transmission_ids" widget="many2many_tags" optional="show"/>
                <field name="condition" optional="show"/>
                <field name="supplier_sku" optional="hide"/>
                <field name="purchase_status" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="product_template_search_view_repuesto" model="ir.ui.view">
        <field name="name">product.template.search.repuesto</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="transmission_ids"/>
                <field name="supplier_sku"/>
                <field name="legacy_code"/>
            </field>
            <filter name="filter_to_purchase" position="after">
                <filter string="No recomprar" name="filter_no_recomprar"
                        domain="[('purchase_status', '=', 'no_recomprar')]"/>
                <filter string="Sin SKU interno" name="filter_sin_sku"
                        domain="[('default_code', '=', False)]"/>
            </filter>
            <filter name="categ_id" position="after">
                <filter string="Código de transmisión" name="groupby_transmission"
                        context="{'group_by': 'transmission_ids'}"/>
                <filter string="Estado" name="groupby_condition"
                        context="{'group_by': 'condition'}"/>
                <filter string="Estado de compra" name="groupby_purchase_status"
                        context="{'group_by': 'purchase_status'}"/>
            </filter>
        </field>
    </record>
</odoo>
